# Build output goes outside the repository (Directory.Build.props). These stay
# as a safety net for a build run some other way.
bin/
obj/
dist/
build/
*.user
tools/*.log

# Claude Code: the project settings and hooks are shared; personal permission
# choices are not.
.claude/settings.local.json

# Landing page for the website, kept out of this repository
site/
design/

# Noise from the Mac side and from iCloud Drive, now that this folder is shared
.DS_Store
._*
.iCloud
Icon?

# Empty two-character folders that appear in the repository root when git
# commits from inside iCloud Drive - the same names git uses under
# .git/objects, created alongside it rather than inside it. Always empty,
# nothing to do with the app, and they come back.
/[0-9a-f][0-9a-f]/
