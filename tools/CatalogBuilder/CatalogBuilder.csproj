<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Developer tool. Regenerates src/HeyTarkov/tasks.json from the two wikis.

    Deliberately a separate project: the shipped application contains no code
    that contacts a wiki at all. This runs on the maintainer's machine, by hand,
    when the task list needs refreshing.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CatalogBuilder</AssemblyName>
    <RootNamespace>HeyTarkov.CatalogBuilder</RootNamespace>
  </PropertyGroup>

</Project>
